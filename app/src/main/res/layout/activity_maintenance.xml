<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_purple_black"
    android:padding="24dp"
    tools:context=".config.MaintenanceActivity">

    <ImageView
        android:id="@+id/maintenanceIv"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="80dp"
        android:src="@drawable/ic_maintenance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vibrant_red" />

    <TextView
        android:id="@+id/titleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Sistem Bakımda"
        android:textAppearance="@style/TextAppearance.Ughmedya.HeadlineBold"
        android:textColor="@color/white"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/maintenanceIv" />

    <TextView
        android:id="@+id/descTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Sizlere daha iyi hizmet verebilmek için çalışıyoruz. Lütfen daha sonra tekrar deneyiniz."
        android:textAppearance="@style/TextAppearance.Ughmedya.LabelSmall"
        android:textColor="@color/on_surface_variant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleTv" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/infoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        app:cardBackgroundColor="@color/media_card_bg"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/descTv"
        app:strokeColor="@color/border_standard"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAHMİNİ BİTİŞ SÜRESİ"
                android:textAppearance="@style/TextAppearance.Ughmedya.LabelBold"
                android:textColor="@color/on_surface_variant" />

            <TextView
                android:id="@+id/endDateTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="24.08.2026 - 18:00"
                android:textAppearance="@style/TextAppearance.Ughmedya.HeadlineSmall"
                android:textColor="@color/vibrant_red"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/closeBtn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="48dp"
        android:backgroundTint="@color/vibrant_red"
        android:text="UYGULAMAYI KAPAT"
        android:textAppearance="@style/TextAppearance.Ughmedya.LabelBold"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="8dp"
        app:layout_constraintTop_toBottomOf="@id/infoCard" />

</androidx.constraintlayout.widget.ConstraintLayout>